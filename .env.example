# Application Configuration
APP_NAME=CareerOS
DEBUG=false
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Supabase PostgreSQL + pgvector)
# Use the Pooler connection string from Supabase Dashboard (Settings -> Database -> Connection String -> Pooler)
POSTGRES_USER=postgres.your-project-ref
POSTGRES_PASSWORD=your-supabase-db-password
POSTGRES_DB=postgres
POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-supabase-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres.your-project-ref:your-supabase-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Redis / Celery (Upstash Redis with TLS)
REDIS_URL=rediss://default:your-upstash-password@your-upstash-host.upstash.io:6379

# AI / LLM APIs
OPENAI_API_KEY=
COHERE_API_KEY=

# Job Search APIs (Optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
RAPIDAPI_KEY=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Storage / AWS S3 (Optional - uses local uploads directory if empty)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS Origins (JSON list or comma separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# Frontend Vite Configuration
VITE_API_URL=https://your-backend-api.onrender.com
