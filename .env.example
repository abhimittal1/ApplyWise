# Application Configuration
APP_NAME=CareerOS
DEBUG=false
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-here-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careeros
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/careeros
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/careeros

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# AI / LLM APIs
OPENAI_API_KEY=
COHERE_API_KEY=

# Job Search APIs (Optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=449bd1fb-edeb-48e8-bc5c-5fae53b77a44
RAPIDAPI_KEY=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Storage / AWS S3 (Optional - uses local uploads directory if empty)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS Origins (JSON list or comma separated)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# Frontend Vite Configuration
VITE_API_URL=http://api:8000
